generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  WAITER
  CASHIER
  ADMIN
  SUPER_ADMIN
  KITCHEN

  @@map("user_roles")
}

enum ServiceStatus {
  ACTIVE
  INACTIVE

  @@map("service_status")
}

enum OrderStatus {
  PENDING
  AUTHORIZED

  @@map("order_status")
}

enum KitchenOrderStatus {
  RECEIVED
  PREPARING
  READY

  @@map("kitchen_order_status")
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  address   String   @db.VarChar(255)
  phone     String   @db.VarChar(30)
  email     String?  @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products         Product[]
  categories       Category[]
  users            User[]
  tables           Table[]
  serviceRequests  ServiceRequest[]
  services         Service[]

  @@map("restaurants")
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  restaurantId Int      @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id])
  productCategories ProductCategory[]

  @@unique([name, restaurantId])
  @@map("categories")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  image        String?  @db.VarChar(500)
  restaurantId Int      @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id])
  productCategories ProductCategory[]
  orderItems          OrderItem[]

  @@index([restaurantId])
  @@map("products")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("products_categories")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  restaurantId Int?     @map("restaurant_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@map("users")
}

model Table {
  id           Int      @id @default(autoincrement())
  number       Int
  qrToken      String   @unique @map("qr_token")
  isActive     Boolean  @default(true) @map("is_active")
  isAvailable  Boolean  @default(true) @map("is_available")
  restaurantId Int      @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id])
  serviceRequests  ServiceRequest[] // NUEVO: relación inversa
  services         Service[]         // NUEVO: relación inversa

  @@unique([number, restaurantId])
  @@index([restaurantId])
  @@index([qrToken])
  @@map("tables")
}

model ServiceRequest {
  id           Int         @id @default(autoincrement())
  tableId      Int         @map("table_id")
  restaurantId Int         @map("restaurant_id")
  status       ServiceStatus @default(ACTIVE) @map("status")
  createdAt    DateTime    @default(now()) @map("created_at")
  closedAt     DateTime?   @map("closed_at")

  table   Table    @relation(fields: [tableId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([tableId])
  @@index([restaurantId])
  @@index([status])
  @@map("service_requests")
}

model Service {
  id           Int         @id @default(autoincrement())
  tableId      Int         @map("table_id")
  restaurantId Int         @map("restaurant_id")
  status       ServiceStatus @default(ACTIVE) @map("status")
  createdAt    DateTime    @default(now()) @map("created_at")

  table   Table    @relation(fields: [tableId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders   Order[]

  @@index([tableId])
  @@index([restaurantId])
  @@index([status])
  @@map("services")
}

model Order {
  id            Int         @id @default(autoincrement())
  serviceId     Int         @map("service_id")
  restaurantId  Int         @map("restaurant_id")
  status        OrderStatus @default(PENDING) @map("status")
  createdAt     DateTime    @default(now()) @map("created_at")
  authorizedAt  DateTime?   @map("authorized_at")

  service   Service    @relation(fields: [serviceId], references: [id])
  orderItems OrderItem[]
  kitchenOrder KitchenOrder?

  @@index([serviceId])
  @@index([restaurantId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int   @map("order_id")
  productId Int   @map("product_id")
  quantity  Int   @default(1)
  price     Decimal @db.Decimal(10, 2) @map("price")

  order   Order    @relation(fields: [orderId], references: [id])
  product Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model KitchenOrder {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique @map("order_id")
  status    KitchenOrderStatus @default(RECEIVED) @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
  @@map("kitchen_orders")
}
